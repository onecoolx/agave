include(ExternalProject)

set(XSLT_NAME "libxslt")
set(XSLT_VERSION "1.1.42")
set(XSLT_PACKAGE "${PROJ_ROOT}/packages/${XSLT_NAME}-${XSLT_VERSION}.tar.gz")
set(XSLT_HASH "b950e8c873069eb570dbc5828eed5a522fc2486edc0cc1dc01d3a360b63a8a62")

ExternalProject_Add(
  ${XSLT_NAME}
  PREFIX "${PROJ_OUT}/${XSLT_NAME}"
  URL "${XSLT_PACKAGE}"
  URL_HASH SHA256=${XSLT_HASH}
  PATCH_COMMAND ${CMAKE_COMMAND} -E copy
    "${PROJ_ROOT}/packages/patchs/${XSLT_NAME}-${XSLT_VERSION}/CMakeLists.txt" "${PROJ_OUT}/${XSLT_NAME}/src/${XSLT_NAME}/"
  BUILD_IN_SOURCE
  CMAKE_ARGS -DCMAKE_BUILD_TYPE=${CMAKE_BUILD_TYPE}
  -DCMAKE_POSITION_INDEPENDENT_CODE=ON
  -DLIBXSLT_WITH_DEBUGGER=OFF
  -DLIBXSLT_WITH_PYTHON=OFF
  -DLIBXSLT_WITH_PROGRAMS=OFF
  -DLIBXSLT_WITH_TESTS=OFF
  -DLIBXSLT_WITH_XSLT_DEBUG=OFF
  -DLIBXSLT_WITH_STATIC_LIBXML2=OFF
  -DCMAKE_INSTALL_PREFIX=${PROJ_OUT}
  -DLIBXML2_INCLUDE_DIRS=${PROJ_OUT}/include/libxml2
  -DBUILD_SHARED_LIBS=${LIB_BUILD_SHARED_VAL}
  ${LIBS_EXTRA_ARGS}
)

include_directories(${PROJ_OUT}/include)
link_directories(${PROJ_OUT}/lib)

add_dependencies(${XSLT_NAME} ${XML2_NAME})

if (OPT_EXT_LIBS_SHARED)
add_library(xslt SHARED IMPORTED)
add_library(exslt SHARED IMPORTED)
else()
add_library(xslt STATIC IMPORTED)
add_library(exslt STATIC IMPORTED)
endif()

if(MSVC)
set_target_properties(xslt PROPERTIES
  IMPORTED_LOCATION_DEBUG ${PROJ_OUT}/lib/libxsltsd${CMAKE_STATIC_LIBRARY_SUFFIX}
  IMPORTED_LOCATION_RELWITHDEBINFO ${PROJ_OUT}/lib/libxslts${CMAKE_STATIC_LIBRARY_SUFFIX}
  IMPORTED_LOCATION_RELEASE ${PROJ_OUT}/lib/libxslts${CMAKE_STATIC_LIBRARY_SUFFIX}
  IMPORTED_LOCATION_MINSIZEREL ${PROJ_OUT}/lib/libxslts${CMAKE_STATIC_LIBRARY_SUFFIX}
  INTERFACE_COMPILE_DEFINITIONS LIBXSLT_STATIC
)

set_target_properties(exslt PROPERTIES
  IMPORTED_LOCATION_DEBUG ${PROJ_OUT}/lib/libexsltsd${CMAKE_STATIC_LIBRARY_SUFFIX}
  IMPORTED_LOCATION_RELWITHDEBINFO ${PROJ_OUT}/lib/libexslts${CMAKE_STATIC_LIBRARY_SUFFIX}
  IMPORTED_LOCATION_RELEASE ${PROJ_OUT}/lib/libexslts${CMAKE_STATIC_LIBRARY_SUFFIX}
  IMPORTED_LOCATION_MINSIZEREL ${PROJ_OUT}/lib/libexslts${CMAKE_STATIC_LIBRARY_SUFFIX}
  INTERFACE_COMPILE_DEFINITIONS LIBXSLT_STATIC
)
else()
if (OPT_EXT_LIBS_SHARED)
set_target_properties(xslt PROPERTIES
  IMPORTED_LOCATION ${PROJ_OUT}/lib/${CMAKE_SHARED_LIBRARY_PREFIX}xslt${CMAKE_SHARED_LIBRARY_SUFFIX}
)

set_target_properties(exslt PROPERTIES
  IMPORTED_LOCATION ${PROJ_OUT}/lib/${CMAKE_SHARED_LIBRARY_PREFIX}exslt${CMAKE_SHARED_LIBRARY_SUFFIX}
)
else()
set_target_properties(xslt PROPERTIES
  IMPORTED_LOCATION ${PROJ_OUT}/lib/${CMAKE_STATIC_LIBRARY_PREFIX}xslt${CMAKE_STATIC_LIBRARY_SUFFIX}
)

set_target_properties(exslt PROPERTIES
  IMPORTED_LOCATION ${PROJ_OUT}/lib/${CMAKE_STATIC_LIBRARY_PREFIX}exslt${CMAKE_STATIC_LIBRARY_SUFFIX}
)
endif()
endif()

set(LIB_DEPS ${LIB_DEPS} xslt exslt)
