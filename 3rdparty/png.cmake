include(ExternalProject)

set(PNG_NAME "libpng")
set(PNG_VERSION "1.6.43")
set(PNG_PACKAGE "${PROJ_ROOT}/packages/${PNG_NAME}-${PNG_VERSION}.tar.gz")
set(PNG_HASH "e804e465d4b109b5ad285a8fb71f0dd3f74f0068f91ce3cdfde618180c174925")

ExternalProject_Add(
  ${PNG_NAME}
  PREFIX "${PROJ_OUT}/${PNG_NAME}"
  URL "${PNG_PACKAGE}"
  URL_HASH SHA256=${PNG_HASH}
  BUILD_IN_SOURCE
  CMAKE_ARGS -DCMAKE_BUILD_TYPE=${CMAKE_BUILD_TYPE}
  -DCMAKE_POSITION_INDEPENDENT_CODE=ON
  -DPNG_TESTS=OFF
  -DPNG_TOOLS=OFF
  -DPNG_SHARED=${LIB_BUILD_SHARED_VAL}
  -DPNG_STATIC=${LIB_BUILD_STATIC_VAL}
  -DZLIB_ROOT=${PROJ_OUT}/${ZLIB_NAME}/src/${ZLIB_NAME}-build
  -DCMAKE_INSTALL_PREFIX=${PROJ_OUT}
  ${LIBS_EXTRA_ARGS}
)
include_directories(${PROJ_OUT}/include)
link_directories(${PROJ_OUT}/lib)

add_dependencies(${PNG_NAME} ${ZLIB_NAME})

if (OPT_EXT_LIBS_SHARED)
add_library(png SHARED IMPORTED)
else()
add_library(png STATIC IMPORTED)
endif()

if(MSVC)
if (OPT_EXT_LIBS_SHARED)
set_target_properties(png PROPERTIES
  IMPORTED_IMPLIB_DEBUG ${PROJ_OUT}/lib/libpng16d${CMAKE_STATIC_LIBRARY_SUFFIX}
  IMPORTED_IMPLIB_RELWITHDEBINFO ${PROJ_OUT}/lib/libpng16${CMAKE_STATIC_LIBRARY_SUFFIX}
  IMPORTED_IMPLIB_RELEASE ${PROJ_OUT}/lib/libpng16${CMAKE_STATIC_LIBRARY_SUFFIX}
  IMPORTED_IMPLIB_MINSIZEREL ${PROJ_OUT}/lib/libpng16${CMAKE_STATIC_LIBRARY_SUFFIX}
)
else()
set_target_properties(png PROPERTIES
  IMPORTED_LOCATION_DEBUG ${PROJ_OUT}/lib/libpng16_staticd${CMAKE_STATIC_LIBRARY_SUFFIX}
  IMPORTED_LOCATION_RELWITHDEBINFO ${PROJ_OUT}/lib/libpng16_static${CMAKE_STATIC_LIBRARY_SUFFIX}
  IMPORTED_LOCATION_RELEASE ${PROJ_OUT}/lib/libpng16_static${CMAKE_STATIC_LIBRARY_SUFFIX}
  IMPORTED_LOCATION_MINSIZEREL ${PROJ_OUT}/lib/libpng16_static${CMAKE_STATIC_LIBRARY_SUFFIX}
)
endif()
else()
if (OPT_EXT_LIBS_SHARED)
set_target_properties(png PROPERTIES
  IMPORTED_LOCATION ${PROJ_OUT}/lib/${CMAKE_SHARED_LIBRARY_PREFIX}png${CMAKE_SHARED_LIBRARY_SUFFIX}
)
else()
set_target_properties(png PROPERTIES
  IMPORTED_LOCATION ${PROJ_OUT}/lib/${CMAKE_STATIC_LIBRARY_PREFIX}png${CMAKE_STATIC_LIBRARY_SUFFIX}
)
endif()
endif()

set(LIB_DEPS ${LIB_DEPS} png)
